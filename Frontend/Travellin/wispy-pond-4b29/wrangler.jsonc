{
  "name": "travellin-app",
  "main": "./dist/Travellin/server/server.mjs",  // Server entry point for Angular Universal
  "compatibility_date": "2025-08-21",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/Travellin/browser"  // Static files from Angular build
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npx ng build && npx ng run Travellin:server"  // Build Angular and server
  }
}