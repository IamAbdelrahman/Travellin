{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CFG": "Data Source=.;Initial Catalog=TravellinDB;Integrated Security=True;Encrypt=True;Trust Server Certificate=True"
  },
  "Cors": {
    "Policy": "AllowTrusted", // to allow all use "AllowAll"
    "AllowedOrigins": [
      "https://localhost:7242", // swagger
      "https://*.ngrok.io", // ngrok
      "http://localhost:4200", // angular app
      "http://localhost:4201",
      "http://localhost:4202",
      "http://localhost:51080"

    ]
  },
  "AppSettings": {
    "BaseUrl": "https://localhost:7242" // Replace this with server url
  },
  "Jwt": {
    "Issuer": "your-app", // Replace with your actual issuer
    "Audience": "your-app", // Replace with your actual audience
    "SigningKey": "super-secret-signing-key-that-is-long-enough-123!", // Replace with your Signing key
    "ExpirationInDays": 7
  },
  "FileStorage": {
    "WebRootPath": "wwwroot",
    "ImageDirectory": "images",
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif" ],
    "MaxFileSizeMB": 5
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "GeneralRules": [
      {
        "Endpoint": "POST:/api/v1/accounts/register",
        "Period": "15m",
        "Limit": 7
      },
      {
        "Endpoint": "POST:/api/v1/accounts/login",
        "Period": "30m",
        "Limit": 506
      }
    ]
  },
